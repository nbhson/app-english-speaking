{
  "name": "fluentdev-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c green,blue \"npm run dev --workspace=@fluentdev/library-api\" \"npm run dev --workspace=ai-english-speaking-coach\"",
    "dev:web": "npm run dev --workspace=ai-english-speaking-coach",
    "dev:server": "npm run dev --workspace=@fluentdev/library-api",
    "build": "npm run build --workspace=ai-english-speaking-coach",
    "test": "npm run test --workspace=ai-english-speaking-coach"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
