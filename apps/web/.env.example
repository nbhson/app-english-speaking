# No secrets required: config is stored in localStorage via Settings UI.
# If you use a remote gateway that requires a key, set it in the app's Settings modal.
# Optional: default gateway URL for local development
VITE_DEFAULT_BASE_URL=http://localhost:20128/v1
# Library API (apps/server, SQLite). Frontend falls back to localStorage if unreachable.
VITE_LIBRARY_API=http://localhost:8241
