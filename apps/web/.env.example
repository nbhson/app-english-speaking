# No secrets required in the web app: config is stored in localStorage via the
# Settings UI. With Connection mode = "Server proxy" (default) the API key
# lives in the SERVER env instead — see apps/server/README.md
# (AI_PROXY_BASE_URL / AI_PROXY_API_KEY). Direct BYOK mode stores the key in
# the browser only if you type it in Settings.
# Optional: default gateway URL for local development
VITE_DEFAULT_BASE_URL=http://localhost:20128/v1
# Library API (apps/server, SQLite). Frontend falls back to localStorage if unreachable.
VITE_LIBRARY_API=http://localhost:8241
